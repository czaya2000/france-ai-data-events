---
import LegalShell from '../components/LegalShell.astro';
import { SITE_NAME, SITE_URL, CONTACT_EMAIL } from '../lib/events';
import { localePath, legalPath } from '../i18n/paths.mjs';
import type { Locale } from '../i18n';

/* Politique de confidentialité / privacy policy, French and English. Written for the RGPD and the French
   Loi Informatique et Libertés; provider facts (transfer mechanisms, retention) follow each provider's own
   public documentation, as already researched for the German edition; where a provider is silent the text says so.
   Facts checked in the code: self-hosted fonts (Base.astro), Umami script only when UMAMI_WEBSITE_ID is set
   (config/country.mjs, set), plain POST forms to FormSubmit (ContactPage, SubmitPage), Buttondown
   form (Subscribe.astro), no cookies set by the site. Not legal advice. */
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const fr = locale === 'fr';
const path = legalPath('privacy', locale);
const title = fr ? `Politique de confidentialité – ${SITE_NAME}` : `Privacy policy – ${SITE_NAME}`;
const description = fr
	? `Ce que ${SITE_NAME} collecte, ce qu’il ne collecte pas, et pourquoi.`
	: `What ${SITE_NAME} collects, what it does not, and why.`;
const legal = localePath(legalPath('legal', locale), locale);
---

<LegalShell title={title} description={description} locale={locale} path={path}>
	{
		fr ? (
			<>
				<h1>Politique de confidentialité</h1>

				<h2>1. Responsable du traitement</h2>
				<p>
					Marcin Czajkowski, e-mail : {CONTACT_EMAIL}, <a href={localePath('/contact/', 'fr')}>formulaire de contact</a>.
